# ZimFeast Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains real secrets
#
# See deployment.md "Credentials Reference" for where to obtain each value.

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
DEBUG=True
SECRET_KEY="CHANGE-ME-generate-a-random-string"
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,zimfeast.com,www.zimfeast.com
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,https://zimfeast.com,https://www.zimfeast.com
DOMAIN=zimfeast.com

# -----------------------------------------------------------------------------
# Database (PostgreSQL - used by all microservices)
# Production: use the RDS endpoint for POSTGRES_HOST
# -----------------------------------------------------------------------------
POSTGRES_USER=zimfeast
POSTGRES_PASSWORD=CHANGE-ME-use-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Per-service databases
AUTH_DB_NAME=zimfeast_auth
RESTAURANT_DB_NAME=zimfeast_restaurants
ORDER_DB_NAME=zimfeast_orders
PAYMENT_DB_NAME=zimfeast_payments

# -----------------------------------------------------------------------------
# Redis
# Production: use the ElastiCache endpoint
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Google Maps API (get from Google Cloud Console)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# -----------------------------------------------------------------------------
# OpenAI (optional - for AI search/recommendations)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# SendGrid (email - get from sendgrid.com)
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key_here

# -----------------------------------------------------------------------------
# Paynow (Zimbabwe payment gateway - get from paynow.co.zw)
# Production: update URLs to https://zimfeast.com/...
# -----------------------------------------------------------------------------
PAYNOW_RETURN_URL=http://localhost/payment-return
PAYNOW_RESULT_URL=http://localhost/api/payments/callback/
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key

# -----------------------------------------------------------------------------
# TumaGo Delivery Partner (get from TumaGo partner dashboard)
# -----------------------------------------------------------------------------
TUMAGO_API_URL=https://tumago.co.zw/api/v1
TUMAGO_API_KEY=your_tumago_api_key
TUMAGO_API_SECRET=your_tumago_api_secret

# -----------------------------------------------------------------------------
# Frontend (Vite)
# Leave empty - frontend uses relative paths (/api/...) which Nginx proxies
# -----------------------------------------------------------------------------
VITE_API_URL=
VITE_REALTIME_URL=

# -----------------------------------------------------------------------------
# Real-time Server
# -----------------------------------------------------------------------------
REALTIME_PORT=3001

# -----------------------------------------------------------------------------
# Inter-service Communication (internal Docker network — no change needed)
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:8001
RESTAURANT_SERVICE_URL=http://restaurant-service:8002
ORDER_SERVICE_URL=http://order-service:8003
PAYMENT_SERVICE_URL=http://payment-service:8005
REALTIME_SERVICE_URL=http://realtime-service:3001
SERVICE_API_KEY=CHANGE-ME-generate-a-random-string

# -----------------------------------------------------------------------------
# JWT (shared across all services for token validation)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# -----------------------------------------------------------------------------
JWT_SECRET_KEY="CHANGE-ME-generate-a-random-string"
JWT_ACCESS_TOKEN_EXPIRY_DAYS=14
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# -----------------------------------------------------------------------------
# Encryption key for sensitive DB fields (Paynow keys etc.)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
FIELD_ENCRYPTION_KEY=CHANGE-ME-generate-with-fernet

# -----------------------------------------------------------------------------
# Admin bootstrap token (required to create the first admin user)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------
ADMIN_SETUP_TOKEN=CHANGE-ME-generate-random-token
