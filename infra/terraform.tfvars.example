# Copy this to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git

aws_region = "af-south-1"
domain     = "zimfeast.com"

# Database
db_username = "zimfeast"
db_password = "CHANGE_ME_TO_A_STRONG_PASSWORD"

# Django
django_secret_key = "CHANGE_ME_TO_A_RANDOM_50_CHAR_STRING"
jwt_secret_key    = "CHANGE_ME_TO_A_RANDOM_50_CHAR_STRING"
service_api_key   = "CHANGE_ME_TO_A_RANDOM_STRING"

# API Keys
google_api_key           = "your_google_api_key"
vite_google_maps_api_key = "your_google_maps_api_key"
openai_api_key           = "your_openai_api_key"
sendgrid_api_key         = "your_sendgrid_api_key"

# Paynow
paynow_integration_id  = "22041"
paynow_integration_key = "your_paynow_integration_key"
