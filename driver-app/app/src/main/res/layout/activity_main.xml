<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_header"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="20dp">

        <!-- Top row: Logo + Online switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ZIMFEAST"
                android:textSize="18sp"
                android:textColor="@color/on_primary"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_online"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textColor="@color/on_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                app:thumbTint="@android:color/white"
                app:trackTint="#80FFFFFF" />
        </LinearLayout>

        <!-- Driver info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_circle" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:tint="@color/primary"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- Name + Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_driver_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Driver"
                    android:textColor="@color/on_primary"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENT -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME TAB -->
        <LinearLayout
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Offline message -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@android:drawable/ic_menu_compass"
                    android:tint="@color/divider"
                    android:layout_marginBottom="16dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tv_offline_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Go online to receive delivery offers"
                    android:textColor="@color/text_tertiary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="center" />
            </LinearLayout>

            <!-- DELIVERY OFFER CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_delivery_offer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_gravity="center"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/secondary_variant"
                app:strokeWidth="2dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Header: New Delivery + Timer -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NEW DELIVERY"
                                android:textSize="11sp"
                                android:textColor="@color/primary"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Order ready for pickup"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Countdown timer circle -->
                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <View
                                android:id="@+id/view_timer_bg"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_timer_circle" />

                            <TextView
                                android:id="@+id/tv_offer_timer"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:gravity="center"
                                android:text="30"
                                android:textSize="20sp"
                                android:textColor="@color/primary"
                                android:fontFamily="sans-serif-black" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Pickup info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_stat_card"
                        android:padding="14dp"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_pickup"
                            android:background="@drawable/bg_icon_circle_small"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PICKUP"
                                android:textSize="10sp"
                                android:textColor="@color/text_tertiary"
                                android:fontFamily="sans-serif-bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/tv_offer_restaurant"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Restaurant Name"
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Dropoff info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_stat_card"
                        android:padding="14dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_dropoff"
                            android:background="@drawable/bg_icon_circle_small"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DROPOFF"
                                android:textSize="10sp"
                                android:textColor="@color/text_tertiary"
                                android:fontFamily="sans-serif-bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/tv_offer_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delivery Address"
                                android:textSize="15sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="2"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Distance + Earnings -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DISTANCE"
                                android:textSize="10sp"
                                android:textColor="@color/text_tertiary"
                                android:fontFamily="sans-serif-bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tv_offer_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2.5 km"
                                android:textSize="18sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-black" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EARNINGS"
                                android:textSize="10sp"
                                android:textColor="@color/text_tertiary"
                                android:fontFamily="sans-serif-bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tv_offer_earnings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$5.50"
                                android:textSize="18sp"
                                android:textColor="@color/success"
                                android:fontFamily="sans-serif-black" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Action buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_decline"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Decline"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-bold"
                            android:textAllCaps="false"
                            android:background="@drawable/bg_decline_button"
                            android:stateListAnimator="@null" />

                        <Button
                            android:id="@+id/btn_accept"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1.5"
                            android:layout_marginStart="8dp"
                            android:text="Accept Delivery"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-black"
                            android:textAllCaps="false"
                            android:background="@drawable/bg_accept_button"
                            android:stateListAnimator="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- EARNINGS TAB -->
        <ScrollView
            android:id="@+id/earnings_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Earnings"
                    android:textSize="22sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="20dp" />

                <!-- Big earnings card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0FDF4"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL EARNED"
                            android:textSize="11sp"
                            android:textColor="@color/text_tertiary"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_total_earnings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textSize="44sp"
                            android:textColor="@color/success"
                            android:fontFamily="sans-serif-black"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stats row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Deliveries -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_notification"
                                android:tint="@color/primary"
                                android:layout_marginBottom="8dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/tv_total_deliveries"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="22sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Deliveries"
                                android:textSize="11sp"
                                android:textColor="@color/text_tertiary"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Distance -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_navigate"
                                android:layout_marginBottom="8dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/tv_total_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 km"
                                android:textSize="22sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Distance"
                                android:textSize="11sp"
                                android:textColor="@color/text_tertiary"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Tips -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_earnings"
                                android:layout_marginBottom="8dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/tv_total_tips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0.00"
                                android:textSize="22sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tips"
                                android:textSize="11sp"
                                android:textColor="@color/text_tertiary"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- SETTINGS TAB -->
        <ScrollView
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="22sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="20dp" />

                <!-- Profile card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROFILE"
                            android:textSize="11sp"
                            android:textColor="@color/primary"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="16dp" />

                        <!-- Name -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_menu_myplaces"
                                android:tint="@color/text_tertiary"
                                android:layout_marginEnd="12dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Name"
                                android:textSize="14sp"
                                android:textColor="@color/text_tertiary"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tv_settings_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Driver"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginBottom="14dp"
                            android:layout_marginStart="32dp" />

                        <!-- Phone -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_menu_call"
                                android:tint="@color/text_tertiary"
                                android:layout_marginEnd="12dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Phone"
                                android:textSize="14sp"
                                android:textColor="@color/text_tertiary"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tv_settings_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Not set"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginBottom="14dp"
                            android:layout_marginStart="32dp" />

                        <!-- Vehicle -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_menu_directions"
                                android:tint="@color/text_tertiary"
                                android:layout_marginEnd="12dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Vehicle"
                                android:textSize="14sp"
                                android:textColor="@color/text_tertiary"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tv_settings_vehicle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Car"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Connection Status -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/view_connection_indicator"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_connection_dot_off"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Connection"
                            android:textSize="14sp"
                            android:textColor="@color/text_tertiary"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_connection_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disconnected"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Logout -->
                <Button
                    android:id="@+id/btn_logout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Log Out"
                    android:textColor="@color/error"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_logout_button"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemRippleColor="@color/ripple_color"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
